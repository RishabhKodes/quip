{
  "name": "quip",
  "private": true,
  "scripts": {
    "dev:extension": "pnpm --filter @quip/extension dev",
    "dev:api": "pnpm --filter @quip/api dev",
    "build:extension": "pnpm --filter @quip/extension build",
    "build:api": "pnpm --filter @quip/api build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9"
}
